<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textAppearance="@android:style/TextAppearance.Material.Headline" />
        <Button android:id="@+id/admin_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin" />
    </LinearLayout>
    <Button android:id="@+id/session_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:contentDescription="@string/select_session_date" android:textAppearance="@android:style/TextAppearance.Material.Medium" />
    <Spinner android:id="@+id/exercise_picker" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/exercise_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@android:style/TextAppearance.Material.Medium" android:textStyle="bold" />
    <LinearLayout android:id="@+id/admin_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/admin_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_mode" android:visibility="gone" />
        <Button android:id="@+id/remove_participant_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove_participant" />
        <Button android:id="@+id/add_exercise_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_exercise" />
        <Button android:id="@+id/remove_exercise_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove_exercise" />
        <Button android:id="@+id/export_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/export" />
        <Button android:id="@+id/export_all_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/export_all" />
        <Button android:id="@+id/clear_attendance_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_attendance" />
    </LinearLayout>
    <TextView android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/no_exercises" />
    <Button android:id="@+id/add_participant_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/add_participant" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/absent" android:textStyle="bold" />
            <ListView android:id="@+id/absent_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/present" android:textStyle="bold" />
            <ListView android:id="@+id/present_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
